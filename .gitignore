# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Localisations Flutter générées (synthetic-package désactivé) — régénérées
# automatiquement à chaque `flutter pub get` / `flutter gen-l10n`.
/lib/l10n/generated/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase emulator persisted data & logs
/emulator-data/
firebase-debug.log
firestore-debug.log
database-debug.log
ui-debug.log
pubsub-debug.log

# Firebase Hosting deploy cache
/.firebase/

# Signature release Android — secrets, JAMAIS versionnés (voir aussi android/.gitignore)
/android/key.properties
/android/app/*.jks
/android/app/*.keystore

# Test coverage artifacts
/coverage/

# Handoff context — local only, not versioned (ne doit pas arriver sur GitHub)
/CONTEXT.md

# Captures d'écran du Store — peuvent contenir des données perso réelles
# (nom, e-mail, téléphone). Local only, jamais commitées.
/store_assets/screenshots/
/store/

# Configs Firebase natives PROD — local only (régénérables via
# `flutterfire configure --project=njuka-prod` ; la référence versionnée
# reste staging, cf. tool/use_env.sh)
/android/app/google-services.prod.json
/ios/Runner/GoogleService-Info.prod.plist

# Répertoire temporaire de sessions outillées
/tmp/
