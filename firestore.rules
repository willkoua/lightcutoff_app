rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.role == 'admin';
    }

    function reportAuthor(reportId) {
      return get(/databases/$(database)/documents/reports/$(reportId))
        .data.userId;
    }

    // Profils utilisateurs : lecture limitée au propriétaire (ou admin).
    // Empêche la ré-identification d'un confirmant via son uid.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      // Mise à jour limitée aux champs de profil (pas de role/status par l'utilisateur).
      allow update: if isOwner(userId)
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['firstName', 'lastName', 'birthDate',
                                 'phoneNumber', 'photoURL', 'homeLocation',
                                 'email', 'updatedAt']);
      allow delete: if false;
    }

    // Index pseudo → { uid, email } : permet la connexion par pseudo
    // (résolution pseudo→email avant authentification). Lecture par id
    // uniquement (pas d'énumération) ; chaque pseudo appartient à un uid.
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn()
                            && resource.data.uid == request.auth.uid;
    }

    // Coupures : lecture pour tout utilisateur connecté.
    match /reports/{reportId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;

      // L'auteur modifie/supprime son signalement ;
      // les autres peuvent uniquement faire varier le compteur de confirmations.
      allow update: if isSignedIn() && (
                      resource.data.userId == request.auth.uid ||
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['confirmationCount', 'updatedAt'])
                    );
      allow delete: if isSignedIn()
                    && resource.data.userId == request.auth.uid;

      // Confirmations : un document par utilisateur (id = uid).
      // Lecture réservée à l'auteur du report, aux admins, ou à sa propre
      // confirmation → les autres ne voient que le compteur (anonymat).
      match /confirmations/{userId} {
        allow read: if isOwner(userId)
                    || isAdmin()
                    || request.auth.uid == reportAuthor(reportId);
        // On ne peut pas confirmer sa propre coupure.
        allow create: if isOwner(userId)
                      && request.auth.uid != reportAuthor(reportId);
        allow delete: if isOwner(userId);
      }
    }

    // Appareils pour notifications push (id = token FCM).
    // Un utilisateur ne gère que ses propres appareils. La Cloud Function
    // d'envoi utilise l'Admin SDK (qui contourne ces règles) pour lire tous
    // les devices et purger les tokens périmés.
    match /devices/{token} {
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId)
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if isOwner(resource.data.userId);
    }
  }
}
