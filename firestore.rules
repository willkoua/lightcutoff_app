rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Vrai pour une session Firebase Anonymous Auth. Les utilisateurs anonymes
    // peuvent signaler et voter, mais N'ONT PAS de profil/pseudo/device : ils
    // doivent d'abord upgrader (linkWithCredential) pour créer ces ressources.
    function isAnonymous() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.role == 'admin';
    }

    function reportAuthor(reportId) {
      return get(/databases/$(database)/documents/reports/$(reportId))
        .data.userId;
    }

    // Incrément d'EXACTEMENT +1 d'un seul compteur (avec `updatedAt`), rien
    // d'autre. Bloque l'écriture d'une valeur arbitraire (ex. 9999).
    function bumpsCounterByOne(field) {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly([field, 'updatedAt'])
        && request.resource.data[field] == resource.data[field] + 1;
    }

    // L'utilisateur crée son propre document de vote (id = uid) dans le MÊME
    // commit atomique, et n'en avait pas déjà un. Garantit qu'on ne peut pas
    // incrémenter le compteur sans déposer un vote, ni voter deux fois.
    function castsVote(reportId, sub) {
      return !exists(/databases/$(database)/documents/reports/$(reportId)/$(sub)/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/reports/$(reportId)/$(sub)/$(request.auth.uid));
    }

    // Profils utilisateurs : lecture limitée au propriétaire (ou admin).
    // Empêche la ré-identification d'un confirmant via son uid.
    // ⚠️ Création/MAJ INTERDITE en session anonyme : il faut d'abord upgrader
    // (linkWithCredential) — le `sign_in_provider` passe alors à `password`/`google`.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && !isAnonymous();
      // Mise à jour limitée aux champs de profil (pas de role/status par
      // l'utilisateur). Le PSEUDO est un cas à part : changeable UNE seule
      // fois à vie — le changement doit décrémenter `usernameChangesLeft`
      // (absent = 1 changement dû, comptes d'avant 2026-07-25) et n'est
      // permis que s'il en reste. Verrou serveur, pas seulement UI.
      allow update: if isOwner(userId) && !isAnonymous()
                    && (
                      request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['firstName', 'lastName', 'birthDate',
                                   'phoneNumber', 'photoURL', 'homeLocation',
                                   'followedQuartiers',
                                   'email', 'updatedAt'])
                      || (
                        request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['username', 'usernameChangesLeft',
                                     'updatedAt'])
                        && request.resource.data.username is string
                        && request.resource.data.username != resource.data.username
                        && resource.data.get('usernameChangesLeft', 1) > 0
                        && request.resource.data.usernameChangesLeft
                           == resource.data.get('usernameChangesLeft', 1) - 1
                      )
                    );
      allow delete: if false;
    }

    // Index pseudo → { uid, email } : permet la connexion par pseudo
    // (résolution pseudo→email avant authentification). Lecture par id
    // uniquement (pas d'énumération) ; chaque pseudo appartient à un uid.
    // ⚠️ Réservé aux comptes upgradés (un anonyme n'a pas de pseudo).
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn() && !isAnonymous()
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn() && !isAnonymous()
                            && resource.data.uid == request.auth.uid;
    }

    // Coupures : lecture pour tout utilisateur connecté.
    match /reports/{reportId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;

      // L'auteur modifie/supprime son signalement (et peut l'archiver via
      // `archivedAt`). Un tiers ne peut QUE faire +1 sur un compteur, et
      // seulement en déposant simultanément son propre vote (sous-collection
      // confirmations/restorations) — ce qui ferme le trou « écrire
      // confirmationCount = 9999 sans voter ». Interdit sur report archivé.
      // L'auteur ne peut pas confirmer sa propre coupure (mais peut déclarer
      // son rétablissement). Les transitions de statut restent portées par les
      // Cloud Functions via l'Admin SDK (qui contourne ces règles).
      allow update: if isSignedIn() && (
                      resource.data.userId == request.auth.uid ||
                      // Modération (site web admin, lot 2d) : un admin ne peut
                      // toucher QUE archiver/restaurer — archivedAt,
                      // autoExpiredAt (restauration d'un expiré) et updatedAt.
                      (
                        isAdmin()
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['archivedAt', 'autoExpiredAt', 'updatedAt'])
                      ) ||
                      (
                        resource.data.get('archivedAt', null) == null && (
                          (
                            bumpsCounterByOne('confirmationCount')
                            && castsVote(reportId, 'confirmations')
                            && request.auth.uid != reportAuthor(reportId)
                          ) ||
                          (
                            bumpsCounterByOne('restorationCount')
                            && castsVote(reportId, 'restorations')
                          )
                        )
                      )
                    );
      allow delete: if isSignedIn()
                    && resource.data.userId == request.auth.uid;

      // Confirmations : un document par utilisateur (id = uid).
      // Lecture réservée au **propriétaire du vote** et aux **admins**
      // uniquement (l'accès de l'auteur du report a été retiré) : le doc
      // contient désormais la position EXACTE du confirmeur (`position`), qui
      // ne doit fuiter vers personne. Les autres ne voient que le compteur.
      // La Cloud Function `onConfirmationCreated` lit `position` via l'Admin
      // SDK (contourne ces règles) pour le ciblage 500 m.
      match /confirmations/{userId} {
        allow read: if isOwner(userId) || isAdmin();
        // On ne peut pas confirmer sa propre coupure. `geohash` (position
        // grossière) et `position` (lat/lng exact) sont optionnels et validés
        // s'ils sont présents.
        allow create: if isOwner(userId)
                      && request.auth.uid != reportAuthor(reportId)
                      && (!('geohash' in request.resource.data)
                          || (request.resource.data.geohash is string
                              && request.resource.data.geohash.size() <= 12))
                      && (!('position' in request.resource.data)
                          || (request.resource.data.position.lat is number
                              && request.resource.data.position.lng is number));
        allow delete: if isOwner(userId);
      }

      // Démentis (« pas de coupure chez moi ») : un document par utilisateur
      // (id = uid). Réponse **Non** au prompt de proximité — signal négatif
      // qui délimite l'emprise de la coupure. Ne touche AUCUN compteur du
      // report (pas de branche bumpsCounterByOne). Position exacte lisible
      // uniquement par le propriétaire/admin (même contrat que confirmations).
      match /denials/{userId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId)
                      && request.auth.uid != reportAuthor(reportId)
                      && (!('geohash' in request.resource.data)
                          || (request.resource.data.geohash is string
                              && request.resource.data.geohash.size() <= 12))
                      && (!('position' in request.resource.data)
                          || (request.resource.data.position.lat is number
                              && request.resource.data.position.lng is number));
        allow delete: if isOwner(userId);
      }

      // Signalements de contenu abusif (exigence UGC des stores, 2026-07-30) :
      // un document par utilisateur (id = uid), raison obligatoire, précision
      // libre courte. AUCUN compteur public (pas de branche
      // bumpsCounterByOne) — examiné par l'équipe via la console/Admin SDK.
      // L'auteur ne peut pas signaler son propre report. Pas de mise à jour
      // (un flag est immuable une fois déposé).
      match /flags/{userId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId)
                      && request.auth.uid != reportAuthor(reportId)
                      && request.resource.data.reason is string
                      && request.resource.data.reason.size() <= 40
                      && (!('details' in request.resource.data)
                          || (request.resource.data.details is string
                              && request.resource.data.details.size() <= 200));
        allow update: if false;
        allow delete: if isOwner(userId);
      }

      // Rétablissements (« le courant est revenu chez moi ») : un document
      // par utilisateur (id = uid). Symétrique aux confirmations, mais
      // **l'auteur peut déclarer son propre rétablissement** — il devient
      // un confirmant comme les autres pour cette action.
      match /restorations/{userId} {
        allow read: if isOwner(userId)
                    || isAdmin()
                    || request.auth.uid == reportAuthor(reportId);
        // Le champ `geohash` (position grossière du confirmeur, conservée pour
        // estimer l'étendue) est optionnel et, s'il est présent, doit être une
        // chaîne courte — symétrique aux confirmations.
        allow create: if isOwner(userId)
                      && (!('geohash' in request.resource.data)
                          || (request.resource.data.geohash is string
                              && request.resource.data.geohash.size() <= 12));
        allow delete: if isOwner(userId);
      }
    }

    // Appareils pour notifications push (id = token FCM).
    // Un utilisateur ne gère que ses propres appareils. La Cloud Function
    // d'envoi utilise l'Admin SDK (qui contourne ces règles) pour lire tous
    // les devices et purger les tokens périmés.
    // ⚠️ Les anonymes ne reçoivent pas de notifs (pas de ciblage possible
    // sans homeLocation/quartiers suivis) → enregistrement device interdit.
    match /devices/{token} {
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow create: if isSignedIn() && !isAnonymous()
                    && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId) && !isAnonymous()
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if isOwner(resource.data.userId);
    }

    // Coupures planifiées importées des fournisseurs officiels (ex. Eneo).
    // Lecture pour tout utilisateur connecté. **Écriture interdite côté
    // client** : la collection est alimentée uniquement par la Cloud Function
    // d'ingestion via l'Admin SDK (qui contourne ces règles).
    match /official_outages/{outageId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
