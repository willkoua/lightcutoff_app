rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Médias des signalements : lisibles par les utilisateurs connectés,
    // déposés uniquement par leur auteur (taille et type limités).
    // NB : la limite 8 Mo doit rester synchronisée avec
    // AppConstants.maxMediaBytes (lib/config/app_constants.dart).
    match /report_media/{uid}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
